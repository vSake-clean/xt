<template>
  <div class="app">
    <div class="expr">
      <image class="sg" for="{{ exprRow }}" src="{{ $item }}"></image>
    </div>
    <div class="disp">
      <image class="bg" for="{{ dispRow }}" src="{{ $item }}"></image>
    </div>
    <div class="pad">
      <div class="row" for="{{ (ri, row) in rows }}">
        <image class="{{ kk.wide ? 'kw' : 'key' }}" for="{{ (ki, kk) in row }}" src="{{ kk.src }}"
               @touchstart="onTouch(kk.k)" @click="onClick(kk.k)"></image>
      </div>
    </div>
  </div>
</template>

<script>
// Kalkulator naukowy na Redmi Watch 4 (Xiaomi Vela).
// Tekst nie jest rysowany przez system, więc wyświetlacz składa się z
// obrazków-znaków (b_<hex>.png, s_<hex>.png), a przyciski to gotowe PNG.
import vibrator from '@system.vibrator'
import { createCalc } from '../../common/calc.js'

const BIG_SLOTS = 12
const SMALL_SLOTS = 24
const BIG_OK = '0123456789.−+×÷^√²!%π()eEro '
const SMALL_OK = '0123456789.−+×÷^√²!%π()eEro ='

function glyphs(prefix, text, slots, ok) {
  let t = String(text)
  if (t.length > slots) t = t.slice(t.length - slots)
  while (t.length < slots) t = ' ' + t
  const out = []
  for (let i = 0; i < t.length; i++) {
    const c = ok.indexOf(t.charAt(i)) >= 0 ? t.charAt(i) : ' '
    out.push('/common/img/' + prefix + '_' + c.charCodeAt(0).toString(16) + '.png')
  }
  return out
}

function key(k, file, wide) {
  return { k: k, src: '/common/img/k_' + file + '.png', wide: !!wide }
}

export default {
  private: {
    exprRow: [],
    dispRow: [],
    rows: [
      [key('C', 'c'), key('(', 'lp'), key(')', 'rp'), key('back', 'back'), key('÷', 'div')],
      [key('√(', 'sqrt'), key('²', 'sq'), key('^', 'pow'), key('%', 'pct'), key('×', 'mul')],
      [key('7', '7'), key('8', '8'), key('9', '9'), key('π', 'pi'), key('−', 'sub')],
      [key('4', '4'), key('5', '5'), key('6', '6'), key('!', 'fact'), key('+', 'add')],
      [key('1', '1'), key('2', '2'), key('3', '3'), key('1÷(', 'inv'), key('ans', 'ans')],
      [key('0', '0', true), key('.', 'dot'), key('=', 'eq', true)]
    ]
  },

  onInit() {
    this._calc = createCalc()
    this._touch = null
    this.exprRow = glyphs('s', '', SMALL_SLOTS, SMALL_OK)
    this.dispRow = glyphs('b', '0', BIG_SLOTS, BIG_OK)
  },

  // System może wysłać touchstart i click dla tego samego dotknięcia.
  // Click tuż po touchstart tego samego klawisza jest ignorowany.
  onTouch(k) {
    this._touch = { k: k, t: Date.now() }
    this._press(k)
  },

  onClick(k) {
    const t = this._touch
    if (t && t.k === k && Date.now() - t.t < 700) return
    this._press(k)
  },

  _press(k) {
    this._calc.press(k)
    this._update(this.exprRow, glyphs('s', this._calc.expr, SMALL_SLOTS, SMALL_OK))
    this._update(this.dispRow, glyphs('b', this._calc.display, BIG_SLOTS, BIG_OK))
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}
  },

  // Jedna zmiana tablicy na listę (szybsze odświeżanie na zegarku).
  _update(arr, next) {
    let same = arr.length === next.length
    for (let i = 0; same && i < next.length; i++) {
      if (arr[i] !== next[i]) same = false
    }
    if (same) return
    Array.prototype.splice.apply(arr, [0, arr.length].concat(next))
  }
}
</script>

<style>
.app {
  width: 390px;
  height: 450px;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 16px;
  background-color: #000000;
}

.expr {
  width: 312px;
  height: 22px;
  flex-direction: row;
  justify-content: flex-end;
}

.sg {
  width: 13px;
  height: 22px;
}

.disp {
  width: 312px;
  height: 44px;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 2px;
  margin-bottom: 8px;
}

.bg {
  width: 26px;
  height: 44px;
}

.pad {
  width: 350px;
  flex-direction: column;
}

.row {
  width: 350px;
  height: 48px;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 5px;
}

.key {
  width: 66px;
  height: 48px;
}

.kw {
  width: 137px;
  height: 48px;
}
</style>
